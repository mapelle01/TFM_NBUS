      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cobertura_municipios' name='federated.1tepsse0j10p2g1a9kkrv0kqray3' />
          </datasources>
          <datasource-dependencies datasource='federated.1tepsse0j10p2g1a9kkrv0kqray3'>
            <column caption='Icono info' datatype='string' name='[Calculation_1391161439875073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;ⓘ&quot;' />
            </column>
            <column caption='Municipio Mapa' datatype='string' name='[municipio_mapa]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1391161439875073]' derivation='None' name='[none:Calculation_1391161439875073:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[perfil_cluster]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1tepsse0j10p2g1a9kkrv0kqray3].[Action (Municipio Mapa,perfil_cluster)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action14_B9B7E5C9AA4E490A9B5BFD0DE36608CB]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[municipio_mapa]' />
              <groupfilter function='level-members' level='[perfil_cluster]' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1tepsse0j10p2g1a9kkrv0kqray3].[Action (Municipio Mapa,perfil_cluster)]</column>
          </slices>
          <aggregation value='true' />
