              <groupfilter function='member' level='[attr:Calculation_1436245616656400:nk]' member='&quot;Alto acceso&quot;' />
              <groupfilter function='member' level='[attr:Calculation_1436245616656400:nk]' member='&quot;Bajo acceso&quot;' />
