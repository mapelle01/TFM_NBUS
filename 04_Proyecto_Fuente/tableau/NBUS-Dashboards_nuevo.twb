      <column caption='Servicios medios diarios visibles' datatype='real' name='[Calculation_0648715959173133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(STR([trip_id]) + &quot;-&quot; + STR([date])) / COUNTD([date])' />
      </column>
      <column caption='Nivel cobertura municipio' datatype='string' name='[Calculation_1016779157389320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0518425132003330] = 0 THEN &quot;🔴 Sin parada&quot;&#13;&#10;ELSEIF [Calculation_0518425132003330] &lt;= 2 THEN &quot;🟡 Baja cobertura&quot;&#13;&#10;ELSE &quot;🟢 Alta cobertura&quot;&#13;&#10;END' />
      </column>
      <column caption='Total de municipios' datatype='integer' name='[Calculation_1016779491569678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNTD([municipio_mapa]) }' />
      </column>
      <column caption='Nº municipios cubiertos' datatype='integer' name='[Calculation_1016779491835919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    COUNTD(&#13;&#10;        IF { FIXED [municipio_mapa] : COUNTD([stop_id 1]) } &gt; 0&#13;&#10;        THEN [municipio_mapa]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='% municipios cubierto' datatype='real' name='[Calculation_1016779492671506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1016779491835919] / [Calculation_1016779491569678]' />
      </column>
      <column caption='Municipios sin parada' datatype='integer' name='[Calculation_1016779495088149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    COUNTD(&#13;&#10;        IF { FIXED [municipio_mapa] : COUNTD([stop_id 1]) } = 0&#13;&#10;        THEN [municipio_mapa]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='% municipios sin parada' datatype='real' name='[Calculation_1016779495239702]' role='measure' type='quantitative'>
