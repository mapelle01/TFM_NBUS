      </column>
      <column caption='Población cubierta' datatype='integer' name='[Calculation_1436244955148289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF { FIXED [municipio_mapa] : COUNTD([stop_id]) } &gt; 0&#13;&#10;        THEN { FIXED [municipio_mapa] : MAX([Calculation_0518425129590784]) }&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='% población cubierta' datatype='real' name='[Calculation_1436244955316226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1436244955148289] / [Calculation_1436244955627523]' />
