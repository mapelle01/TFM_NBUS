            <column-instance column='[Calculation_1436244962426890]' derivation='Sum' name='[sum:Calculation_1436244962426890:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1436244962517003]' derivation='Sum' name='[sum:Calculation_1436244962517003:qk]' pivot='key' type='quantitative' />
