      <aliases enabled='yes' />
      <column caption='Población municipio año' datatype='integer' name='[Calculation_0518425129590784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [cod_municipio 1], [anio] : MIN([poblacion]) }' />
      </column>
      <column caption=' Nº de paradas municipio' datatype='integer' name='[Calculation_0518425132003330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipio_mapa] :&#13;&#10;    COUNTD([stop_id])&#13;&#10;}' />
      </column>
      <column caption='Servicios medios diarios' datatype='real' name='[Calculation_0518425132318724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(STR([trip_id]) + &quot;-&quot; + STR([date]))&#13;&#10;/&#13;&#10;COUNTD([date])' />
      </column>
      <column caption='Servicios diarios por 1.000 hab.' datatype='real' datatype-customized='true' default-format='*0.00%' name='[Calculation_0518425132392453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0518425132318724] / SUM([Calculation_0518425129590784]) * 1000' />
      </column>
      <column caption='Tiene parada' datatype='string' name='[Calculation_0518425139646472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_0518425132003330] &gt; 0, &quot;Con parada&quot;, &quot;Sin parada&quot;)' />
      </column>
      <column caption='Nivel cobertura municipio' datatype='string' name='[Calculation_1016779157389320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0518425132003330] = 0 THEN &quot;🔴 Sin parada&quot;&#13;&#10;ELSEIF [Calculation_0518425132003330] &lt;= 2 THEN &quot;🟡 Baja cobertura&quot;&#13;&#10;ELSE &quot;🟢 Alta cobertura&quot;&#13;&#10;END' />
      </column>
      <column caption='Total de municipios' datatype='integer' name='[Calculation_1016779491569678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNTD([municipio_mapa]) }' />
      </column>
      <column caption='Nº municipios cubiertos' datatype='integer' name='[Calculation_1016779491835919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [tiene_parada] THEN [municipio_mapa] END)' />
      </column>
      <column caption='% municipios cubierto' datatype='real' name='[Calculation_1016779492671506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [tiene_parada] THEN [municipio_mapa] END) &#13;&#10;/ &#13;&#10;COUNTD([municipio_mapa])' />
      </column>
      <column caption='Municipios sin parada' datatype='integer' name='[Calculation_1016779495088149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year] : COUNTD([municipio_mapa]) }&#13;&#10;-&#13;&#10;{ FIXED [year] : COUNTD(IF [tiene_parada] = TRUE THEN [municipio_mapa] END) }' />
      </column>
      <column caption='% municipios sin parada' datatype='real' name='[Calculation_1016779495239702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;  { FIXED [year] : COUNTD([municipio_mapa]) }&#13;&#10;  -&#13;&#10;  { FIXED [year] : COUNTD(IF [tiene_parada] = TRUE THEN [municipio_mapa] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED [year] : COUNTD([municipio_mapa]) }' />
      </column>
      <column caption='Flag municipio alta frecuencia' datatype='integer' name='[Calculation_1016779500363800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1016779501015065] &gt;= 10 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Servicios diarios municipio' datatype='integer' name='[Calculation_1016779501015065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipio_mapa] : COUNTD([trip_id]) }' />
