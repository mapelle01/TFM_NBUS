      <column caption='Mostrar Estado B' datatype='boolean' name='[Calculation_1016780168806442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 1] &lt;&gt; &quot;Sin selección&quot;' />
