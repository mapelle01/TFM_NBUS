    <worksheet name='Texto c - población cubierta '>
      <table>
        <view>
          <datasources>
            <datasource caption='dashboard_2' name='federated.06lunza0nhxj6i1fdpguh1tvzuwo' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Año seleccionado' datatype='integer' name='[Parámetro 2]' param-domain-type='list' role='measure' type='quantitative' value='2024'>
              <calculation class='tableau' formula='2024' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06lunza0nhxj6i1fdpguh1tvzuwo'>
            <column caption='Población municipio año' datatype='integer' name='[Calculation_0518425129590784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [cod_municipio], [anio] : MIN([poblacion]) }' />
            </column>
            <column caption='Nº de paradas municipio' datatype='integer' name='[Calculation_1016780158935076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipio_mapa] : COUNTD([stop_id]) }' />
            </column>
            <column caption='Población municipio única' datatype='integer' name='[Calculation_1016780159348774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipio_mapa] : MAX([Calculation_0518425129590784]) }' />
            </column>
            <column caption='Año limpio 2' datatype='boolean' name='[Calculation_1185836784836618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([date]) OR YEAR([date]) = [Parameters].[Parámetro 2]' />
            </column>
            <column caption='Población cubierta' datatype='integer' name='[Calculation_1436244955148289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF { FIXED [municipio_mapa] : COUNTD([stop_id]) } &gt; 0&#13;&#10;        THEN { FIXED [municipio_mapa] : MAX([Calculation_0518425129590784]) }&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='% población cubierta' datatype='real' name='[Calculation_1436244955316226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1436244955148289] / [Calculation_1436244955627523]' />
            </column>
            <column caption='Población total' datatype='integer' name='[Calculation_1436244955627523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM([Calculation_1016780159348774]) }' />
            </column>
            <column caption='Nivel de acceso poblacional' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1436245616656400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1016780158935076] = 0 THEN &quot;Sin acceso&quot;&#13;&#10;ELSEIF [Calculation_1436245616840721] &lt; 2 THEN &quot;Bajo acceso&quot;&#13;&#10;ELSEIF [Calculation_1436245616840721] &lt; 5 THEN &quot;Acceso medio&quot;&#13;&#10;ELSE &quot;Alto acceso&quot;&#13;&#10;END' />
            </column>
            <column caption='Paradas por 10.000 habitantes' datatype='real' name='[Calculation_1436245616840721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1016780158935076]) / [Calculation_0518425129590784] * 10000' />
            </column>
            <column caption='Población municipio año seleccionado' datatype='integer' name='[Calculation_1436245629083667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [cod_municipio] :&#13;&#10;    MAX(&#13;&#10;        IIF([anio] = [Parameters].[Parámetro 2], [poblacion], NULL)&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Tramo poblacional' datatype='string' name='[Calculation_1436245665611799]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1436245629083667] &gt; 50000 THEN &quot;&gt; 50.000 hab.&quot;&#13;&#10;ELSEIF [Calculation_1436245629083667] &gt; 10000 THEN &quot;10.001 - 50.000&quot;&#13;&#10;ELSEIF [Calculation_1436245629083667] &gt; 2000 THEN &quot;2.001 - 10.000&quot;&#13;&#10;ELSE &quot;&lt; 2.000 hab.&quot;&#13;&#10;END' />
            </column>
            <column caption='Anio' datatype='integer' name='[anio]' role='measure' type='quantitative' />
            <column caption='Cod Municipio' datatype='string' default-role='measure' default-type='quantitative' name='[cod_municipio]' role='dimension' type='nominal' />
            <column aggregation='Count' caption='Date' datatype='date' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
            <column caption='Municipio Mapa' datatype='string' name='[municipio_mapa]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1185836784836618]' derivation='None' name='[none:Calculation_1185836784836618:nk]' pivot='key' type='nominal' />
            <column caption='Poblacion' datatype='integer' name='[poblacion]' role='measure' type='quantitative' />
            <column datatype='string' name='[stop_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1436244955148289]' derivation='Sum' name='[sum:Calculation_1436244955148289:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1436244955316226]' derivation='Sum' name='[sum:Calculation_1436244955316226:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.06lunza0nhxj6i1fdpguh1tvzuwo].[Action (Municipio Mapa)]'>
            <groupfilter function='level-members' level='[municipio_mapa]' user:ui-action-filter='[Action5_A8E2784479224175A322518C70B76CEF]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.06lunza0nhxj6i1fdpguh1tvzuwo].[Action (Nivel de acceso poblacional,Municipio Mapa)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action4_BDE5639353604B77B2ED1AD0CC100FB9]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_1436245616656400]' />
