      <column caption='Población total' datatype='integer' name='[Calculation_1436244955627523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Calculation_1016780159348774]) }' />
      </column>
      <column caption='Donut población cubierta - valor' datatype='integer' name='[Calculation_1436244956348420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1436244955148289]' />
