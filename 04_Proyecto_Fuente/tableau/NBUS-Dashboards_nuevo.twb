      </column>
      <column caption='Servicios medios diarios' datatype='real' name='[Calculation_0518425132318724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(STR([trip_id]) + &quot;-&quot; + STR([date]))&#13;&#10;/&#13;&#10;COUNTD([date])' />
