            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.06lunza0nhxj6i1fdpguh1tvzuwo].[Action (Tramo poblacional)]'>
            <groupfilter function='level-members' level='[Calculation_1436245665611799]' user:ui-action-filter='[Action3_5A1C63369EEF4764A11B54AEF229A7B9]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.06lunza0nhxj6i1fdpguh1tvzuwo].[none:Calculation_1185836784836618:nk]'>
            <groupfilter function='member' level='[none:Calculation_1185836784836618:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
