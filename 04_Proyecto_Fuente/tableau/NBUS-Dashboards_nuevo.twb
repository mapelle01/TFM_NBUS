      <column caption='Frecuencia diaria media' datatype='real' name='[Calculation_1185836104597504 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_expediciones] / [num_dias_activo]' />
      </column>
      <column caption='Frecuencia diaria ' datatype='real' name='[Calculation_1185836104597504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1185836148162567] THEN [trip_id] END) / COUNTD([fecha])' />
      </column>
      <column caption='Expediciones sentido' datatype='integer' name='[Calculation_1185836109987842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 7] = &quot;Ida&quot; THEN [exp_ida]&#13;&#10;ELSEIF [Parameters].[Parámetro 7] = &quot;Vuelta&quot; THEN [exp_vuelta]&#13;&#10;ELSE [exp_ida] + [exp_vuelta]&#13;&#10;END' />
      </column>
      <column caption='Filtro año' datatype='boolean' name='[Calculation_1185836133769219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 2] = 0 OR [year] = [Parameters].[Parámetro 2]' />
      </column>
      <column caption='actividad_temporal' datatype='boolean' name='[Calculation_1185836141809669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 2] = 0 OR [year] = [Parameters].[Parámetro 2]' />
      </column>
      <column caption='Expediciones sentido temporal' datatype='integer' name='[Calculation_1185836147847174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 7] = &quot;Ida&quot; THEN&#13;&#10;    IF [direction_label] = &quot;Ida&quot; THEN 1 ELSE 0 END&#13;&#10;ELSEIF [Parameters].[Parámetro 7] = &quot;Vuelta&quot; THEN&#13;&#10;    IF [direction_label] = &quot;Vuelta&quot; THEN 1 ELSE 0 END&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='Filtro sentido' datatype='boolean' name='[Calculation_1185836148162567]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 7] = &quot;Todo&quot; OR [direction_label] = [Parameters].[Parámetro 7]' />
      </column>
      <column caption='Icono info' datatype='string' name='[Calculation_1391161439875073]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;ⓘ&quot;' />
      </column>
      <column caption='Mostrar hoja paradas' datatype='boolean' name='[Calculation_1661372755832845]' role='dimension' type='nominal'>
