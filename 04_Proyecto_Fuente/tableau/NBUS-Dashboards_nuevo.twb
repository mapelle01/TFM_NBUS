      <column caption='Alta frecuencia texto' datatype='string' name='[Calculation_1016780151210019]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1016779500363800] = 1 THEN &quot;Sí&quot; ELSE &quot;No&quot; END' />
      </column>
      <column caption='Nº de paradas municipio' datatype='integer' name='[Calculation_1016780158935076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipio_mapa] : COUNTD([stop_id]) }' />
      </column>
      <column caption='Cobertura relativa municipio' datatype='real' name='[Calculation_1016780159270949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1016780159348774] &gt; 0 THEN&#13;&#10;    [Calculation_1016780158935076] / [Calculation_1016780159348774] * 10000&#13;&#10;END' />
      </column>
      <column caption='Población municipio única' datatype='integer' name='[Calculation_1016780159348774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipio_mapa] : MAX([Calculation_0518425129590784]) }' />
