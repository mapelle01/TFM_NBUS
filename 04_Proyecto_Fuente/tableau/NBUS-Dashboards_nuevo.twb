      <column caption='Ruta seleccionada bonita' datatype='string' name='[Calculation_1661373091676176]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 5] = &quot;Ninguna&quot; THEN&#13;&#10;&#13;&#10;    &quot;Seleccione una ruta&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    MIN(&#13;&#10;        IF [shape_id] = [Parameters].[Parámetro 5] THEN&#13;&#10;            [route_long_name]&#13;&#10;        END&#13;&#10;    )&#13;&#10;&#13;&#10;END' />
