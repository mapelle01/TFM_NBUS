              <text column='[federated.1tepsse0j10p2g1a9kkrv0kqray3].[none:Calculation_1391161439875073:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#000000' fontname='Segoe UI'>Dashboard interactivo que analiza el impacto del acceso al transporte público desde una perspectiva poblacional en la Comunidad Foral de Navarra.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontname='Segoe UI'>Permite identificar desigualdades territoriales, evaluar la evolución histórica de la población sin acceso directo al servicio (2022-2025), y detectar qué tipos de municipios —según su tamaño demográfico— concentran las mayores dificultades de cobertura.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontname='Segoe UI'>Los filtros de municipio y año permiten explorar en detalle el nivel de acceso de cada zona, distinguiendo entre población con parada directa, con acceso medio o sin ningún tipo de cobertura del servicio NBUS.</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontsize='15'>&lt;</run>
                <run fontsize='15'>[federated.1tepsse0j10p2g1a9kkrv0kqray3].[none:Calculation_1391161439875073:nk]</run>
                <run fontsize='15'>&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minwidth' value='-1' />
                <format attr='maxwidth' value='-1' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{9A2423FC-6396-41F8-8E84-6C0BAF6EBEE3}' />
