      </column>
      <column caption='Mostrar Estado A' datatype='boolean' name='[Calculation_1016780167602217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 1] = &quot;Sin selección&quot;' />
