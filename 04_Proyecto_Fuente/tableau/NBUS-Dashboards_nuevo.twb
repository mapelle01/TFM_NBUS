      <column caption='Donut población baja cobertura - resto' datatype='integer' name='[Calculation_1436244962664461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1436244955627523] - [Calculation_1436244962426890]' />
      </column>
      <column caption='Flag municipio baja cobertura' datatype='integer' name='[Calculation_1436244967665678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(UPPER(TRIM([Calculation_1016779157389320])), &quot;BAJA&quot;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='Población con acceso insuficiente' datatype='integer' name='[Calculation_1436245616582671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipio_mapa], [anio] :&#13;&#10;    MIN(&#13;&#10;        IF [Calculation_1436245616656400] = &quot;Sin acceso&quot;&#13;&#10;        OR [Calculation_1436245616656400] = &quot;Bajo acceso&quot;&#13;&#10;        THEN [Calculation_0518425129590784]&#13;&#10;        ELSE 0&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Nivel de acceso poblacional' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1436245616656400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1016780158935076] = 0 THEN &quot;Sin acceso&quot;&#13;&#10;ELSEIF [Calculation_1436245616840721] &lt; 2 THEN &quot;Bajo acceso&quot;&#13;&#10;ELSEIF [Calculation_1436245616840721] &lt; 5 THEN &quot;Acceso medio&quot;&#13;&#10;ELSE &quot;Alto acceso&quot;&#13;&#10;END' />
      </column>
      <column caption='Paradas por 10.000 habitantes' datatype='real' name='[Calculation_1436245616840721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_1016780158935076]) / [Calculation_0518425129590784] * 10000' />
      </column>
      <column caption='Población municipio año seleccionado' datatype='integer' name='[Calculation_1436245629083667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [cod_municipio] :&#13;&#10;    MAX(&#13;&#10;        IIF([anio] = [Parameters].[Parámetro 2], [poblacion], NULL)&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Población total año seleccionado' datatype='integer' name='[Calculation_1436245629313044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM([Calculation_1436245629083667])&#13;&#10;}' />
      </column>
      <column caption='Población con acceso insuficiente año seleccionado' datatype='integer' name='[Calculation_1436245629960213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1436245616656400] = &quot;Sin acceso&quot;&#13;&#10;OR [Calculation_1436245616656400] = &quot;Bajo acceso&quot;&#13;&#10;THEN [Calculation_1436245629083667]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Sin acceso directo (flag)' datatype='integer' name='[Calculation_1436245665464342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1016780158935076] = 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Tramo poblacional' datatype='string' name='[Calculation_1436245665611799]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1436245629083667] &gt; 50000 THEN &quot;&gt; 50.000 hab.&quot;&#13;&#10;ELSEIF [Calculation_1436245629083667] &gt; 10000 THEN &quot;10.001 - 50.000&quot;&#13;&#10;ELSEIF [Calculation_1436245629083667] &gt; 2000 THEN &quot;2.001 - 10.000&quot;&#13;&#10;ELSE &quot;&lt; 2.000 hab.&quot;&#13;&#10;END' />
      </column>
      <column caption='Población sin acceso directo' datatype='integer' name='[Calculation_1436245665697816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1436245665464342] = 1 THEN [Calculation_1436245629083667]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Población sin acceso anual' datatype='integer' name='[Calculation_1436245675859994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1016780158935076] = 0 THEN [poblacion]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Recuento filas' datatype='integer' name='[Calculation_1439277415956481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
